# Copie este arquivo para .env e preencha com as credenciais reais.
# .env já está no .gitignore — nunca commitar credenciais reais.

ONU_HOST=192.168.100.1
ONU_USERNAME=
ONU_PASSWORD=

# Descoberta automática (Devices -> Escanear Rede)
SNMP_COMMUNITY=public
SNMP_TIMEOUT=1.5
SNMP_RETRIES=0
SCAN_MAX_WORKERS=40
SCAN_MAX_HOSTS=1024
