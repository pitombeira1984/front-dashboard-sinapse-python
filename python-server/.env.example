# Copie este arquivo para .env e preencha com as credenciais reais.
# .env já está no .gitignore — nunca commitar credenciais reais.

ONU_HOST=192.168.100.1
ONU_USERNAME=
ONU_PASSWORD=

# Poller da ONU real (painel web /boaform) — substitui os valores simulados da
# ONU de ONU_POLLER_ONU_ID (1..18, ver mock_engine.ONU_PROFILES) pelos reais.
ONU_POLLER_ENABLED=false
ONU_POLLER_ONU_ID=1
ONU_POLLER_INTERVAL=10

# Descoberta automática (Devices -> Escanear Rede)
SNMP_COMMUNITY=public
SNMP_TIMEOUT=1.5
SNMP_RETRIES=0
SCAN_MAX_WORKERS=40
SCAN_MAX_HOSTS=1024
